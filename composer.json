{
    "name": "romanfedorskij/message-bus",
    "description": "Typed PHP message bus with deterministic handler registry and durable delivery runtime",
    "type": "library",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "psr/clock": "^1.0"
    },
    "license": "MIT",
    "autoload": {
        "classmap": [
            "src/"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ]
    },
    "bin": [
        "bin/message-bus",
        "bin/message-bus-worker"
    ],
    "scripts": {
        "test": "vendor/bin/phpunit --do-not-cache-result",
        "test:integration": "vendor/bin/phpunit -c phpunit.integration.xml.dist --do-not-cache-result",
        "test:process": "vendor/bin/phpunit -c phpunit.process.xml.dist --do-not-cache-result",
        "test:coverage": [
            "php -d xdebug.mode=coverage vendor/bin/phpunit -c phpunit.coverage.xml.dist --coverage-clover /tmp/messagebus-coverage.xml --coverage-text --colors=never --only-summary-for-coverage-text --do-not-cache-result --cache-directory /tmp/messagebus-phpunit-cache",
            "@php tools/assert-coverage.php /tmp/messagebus-coverage.xml 80 80"
        ],
        "analyse": "@php -d memory_limit=512M vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --no-progress --debug",
        "cs:check": "@php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --sequential",
        "cs:fix": "@php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --sequential",
        "rector:check": "@php vendor/bin/rector process --config=rector.php --dry-run",
        "api:write": "@php tools/api-manifest.php --write",
        "api:check": "@php tools/api-manifest.php --check",
        "compatibility:check": "@php tools/compatibility-check.php",
        "docs:check": "@php tools/docs-check.php",
        "example:orchestration": "@php examples/orchestration/run.php",
        "example:durable": "@php examples/durable-postgres/run.php",
        "examples:check": "@php tools/examples-check.php",
        "source:scan": "@php tools/source-scan.php",
        "skill:check": "@php tools/skill-check.php",
        "archive:check": "@php tools/archive-check.php"
    },
    "authors": [
        {
            "name": "romanfedorskij",
            "email": "markaryanroma@mail.ru"
        }
    ],
    "minimum-stability": "stable",
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpyh/coding-standard": "^2.6.3",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "rector/rector": "^2.7",
        "symfony/console": "^6.4 || ^7.0"
    },
    "suggest": {
        "ext-pcntl": "Required by the production PCNTL worker supervisor.",
        "ext-posix": "Required for worker child signalling.",
        "ext-pdo_pgsql": "Required by the PostgreSQL durable runtime.",
        "psr/log": "Required only by the optional PSR-3 runtime observer.",
        "symfony/console": "Required only by optional operator commands."
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "extra": {
        "skills": {
            "source": "resources/skills"
        }
    }
}
