{
    "name": "romanfedorskij/message-bus",
    "description": "Attribute-driven PHP message bus with flows, compiled registry, queue transport contracts, and immutable envelopes",
    "type": "library",
    "require": {
        "php": "^8.3",
        "psr/clock": "^1.0",
        "psr/container": "^1.1 || ^2.0",
        "symfony/var-exporter": "^6.4 || ^7.0",
        "ext-json": "*"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Wolfcharaa\\MessageBus\\": "src"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "authors": [
        {
            "name": "romanfedorskij",
            "email": "markaryanroma@mail.ru"
        }
    ],
    "minimum-stability": "stable",
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    }
}
