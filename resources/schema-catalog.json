                ["pid", "integer", false],
                ["build_id", "text", false],
                ["registry_hash", "character(64)", false],
                ["lifecycle", "text", false],
                ["capacity", "integer", false],
                ["active_attempts", "integer", false],
                ["applied_global_revision", "bigint", false],
                ["applied_profile_revision", "bigint", false],
                ["started_at", "timestamp with time zone", false],
                ["heartbeat_at", "timestamp with time zone", false],
                ["stopped_at", "timestamp with time zone", true]
