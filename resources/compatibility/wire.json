        "retryable", "terminal"
    ],
    "payload_contract": {
        "name_attribute": "Wolfcharaa\\MessageBus\\Attribute\\MessageName",
        "version_attribute": "Wolfcharaa\\MessageBus\\Attribute\\Payload",
        "minimum_version": 1
    }
}
