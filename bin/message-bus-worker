#!/usr/bin/env php
<?php

require $_composer_autoload_path ?? __DIR__ . '/../vendor/autoload.php';

$bootstrap = getenv('MESSAGE_BUS_BOOTSTRAP');
if (!is_string($bootstrap) || $bootstrap === '' || !is_file($bootstrap)) {
    fwrite(STDERR, "Set MESSAGE_BUS_BOOTSTRAP to a PHP file returning a Symfony Console Application.\n");
    exit(2);
}
$application = require $bootstrap;
if (!$application instanceof Symfony\Component\Console\Application) {
    fwrite(STDERR, "MESSAGE_BUS_BOOTSTRAP must return Symfony Console Application.\n");
    exit(2);
}
$application->setDefaultCommand('worker:run', true);
exit($application->run());
